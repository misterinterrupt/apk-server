[Unit]
Description=RobotNerd APK Server (HTTP)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/interrupt/Documents/apk-server
ExecStart=/usr/bin/python3 serve.py
# `always` (not `on-failure`): a stray SIGTERM/SIGKILL from a tool or
# manual kill will also trigger a restart, so the server can't be left
# dead by accident. Explicit `systemctl --user stop` is still respected.
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=robotnerd-apk-server

[Install]
WantedBy=default.target
